## Data:
```{r}
ec_daily_mngmnt2 <- read_csv("ec_daily_mngmnt_esf2.csv")
ec_daily_mngmnt2$date <- mdy(ec_daily_mngmnt2$date)
# make sure management is in factor form
ec_daily_mngmnt2$management <- factor(as.character(ec_daily_mngmnt2$management))
# same for crop stage:
ec_daily_mngmnt2$crop_stage_simple <- factor(
  ec_daily_mngmnt2$crop_stage_simple,
  levels = c("mature", "early", "vegetative", "reproductive", "grain_fill", "dormant", "fallow")
)
ec_daily_mngmnt2$year <- as.factor(ec_daily_mngmnt2$year)
```

## Define stress threshold using VPD (vapor pressure deficit) data:
```{r}
# use quantile function to find upper and lower quantiles of each VPD and average soil moisture (VWC), determine if there exists drought stress based on if a line has both higher than average VPD and lower than average VWC: 
ec_daily_mngmnt2 <- ec_daily_mngmnt2 %>%
  mutate(
    drought_stress = VPD > quantile(VPD, 0.75, na.rm = TRUE) & 
                     vwc_avg < quantile(vwc_avg, 0.25, na.rm = TRUE)
  )
```

## Alt: Define drought using US Drought Monitoring Index
https://www.drought.gov/data-maps-tools/us-drought-monitor
https://droughtmonitor.unl.edu/DmData/DataDownload/ComprehensiveStatistics.aspx
All data are in percent area of each drought category for the time period (one week). Match the dates to the EC data.
```{r}
usdm <- read_csv("USDM_ColumbiaCountyNY.csv")
usdm$start <- as.Date(usdm$start, format = "%m/%d/%y")
usdm$end <- as.Date(usdm$end, format = "%m/%d/%y")
usdm <- usdm %>% 
  select(!c(County, State))

# expand using seq() to create a row for each date within each week-long period (demarcated by the start and end columns in each existing row) and copy/paste the drought data for that week to each date within the week:
usdm_exp <- usdm %>%
  rowwise() %>%
  mutate(date = list(seq.Date(start, end, by = "day"))) %>%
  unnest(cols = c(date)) %>%
  ungroup()

# categorize each day's drought level by the percentage area of each drought category:
# D0 = abnormally dry, pre-drought; D1 = Moderate; D2 = Severe; D3 = Extreme; D4 = Exceptional
usdm_exp <- usdm_exp %>% 
  mutate(drought_risk =
    if_else(None > 50, "none",
            if_else(D0_percarea > 50, "abnormally dry",
                    if_else(D1_percarea > 50, "moderate",
                            if_else(D2_percarea > 50, "severe",
                                    # default drought conditions should not exist based on above logic: NA
                                    NA)))))
usdm_final <- usdm_exp %>% 
  select(date, drought_risk) %>% 
  # relevel the factors of drought
  mutate(drought_risk = fct_relevel(drought_risk, c("none", "abnormally dry", "moderate")))

# bind the USDM drought risk data to the average hourly management data using time stamps
ec_daily_mngmnt2 <- ec_daily_mngmnt2 %>% 
  left_join(usdm_final) %>% 
  # rename drought columns for clarity:
  rename(calculated_drought = drought_stress,
         usdm_drought = drought_risk)
  # re-level the factors

```


## Model NEE with stress indicator:
```{r}
g_resilience <- gam(NEE ~ 
                    management * crop_stage_simple *  usdm_drought +
                      
                    s(year, bs = "re", by = management) +
                    s(doy, bs = "cc", k = 20) +
                    
                      ti(soilt_avg, vwc_avg, by = management) +
                    
                      s(VPD, by = management) +
                    
                      s(soilt_avg, by = management),
                  data = ec_daily_mngmnt2,
                  method = "REML")

appraise(g_resilience)
```

summary statistics of model
```{r}
summary(g_resilience)
```

## Test hypothesis: Organic has advantage in NEE response during drought
```{r}
emm <- emmeans(g_resilience, ~ management | usdm_drought | crop_stage_simple)
contrast(emm, method = "pairwise")  # Is organic advantage BIGGER during drought?

```

