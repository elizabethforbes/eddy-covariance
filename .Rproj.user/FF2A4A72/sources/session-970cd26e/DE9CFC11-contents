data_quality
```
```{r}
# calculate annual cumulative fluxes
ec_cumulative_annual <- ec_daily_NEEgf1 %>% 
  group_by(management, year) %>% 
  summarize(
    # counts:
    n_days = n(),
    n_days_measured = sum(NEE_source == "empirical", na.rm = TRUE),
    n_days_gapfilled = sum(NEE_source != "empirical", na.rm = TRUE),
    pct_gapfilled = round(100 * n_days_gapfilled / n_days, 1),
    # cumulative fluxes of the column for which there is combined empirical and RF modeled data:
    cum_NEE = sum(NEE_emp_gf, na.rm = TRUE),
    # mean daily values for context:
    mean_daily_NEE = mean(NEE_emp_gf, na.rm = TRUE),
    # sum of variances, square rooted
    cum_NEE_se = sqrt(sum(NEE_se^2, na.rm = TRUE)),
    # environmental context:
    mean_VPD = mean(VPD, na.rm = TRUE),
    mean_soilt = mean(soilt_avg, na.rm = TRUE),
    mean_vwc = mean(vwc_avg, na.rm = TRUE),
    mean_airt = mean(airt, na.rm = TRUE),
    
    .groups = "drop"
  ) %>% 
  mutate(
  # convert to kg/ha from gC/m2
    cum_NEE_kg_ha = cum_NEE *10,
    # carbon sink classification
    carbon_balance = case_when(
      cum_NEE < -50 ~ "strong sink",
      cum_NEE >- -50 & cum_NEE < 0 ~ "weak sink",
      cum_NEE >= 0 & cum_NEE < 50 ~ "weak source",
      cum_NEE >= 50 ~ "strong source"
    )
  )
    
```

