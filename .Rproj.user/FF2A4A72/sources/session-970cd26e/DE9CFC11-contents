## Method 2: GAM predicted gapfilling
Because there is missing data in the VPD column, we need to impute measurements there first.

```{r}
# check for missing predictors in missing rows:
missing_data_subset <- ec_daily_mngmnt4[missing_idx, ]

# Check for any NA in predictors used in the model
colnames_predictors <- c("management", "crop_stage_simple", "year", "doy", "soilt_avg", "vwc_avg", "VPD", "days_since_tillage")
colSums(is.na(missing_data_subset[, colnames_predictors]))
```
789 total missing measurements for VPD, none for other variables.

Impute missing VPD measurements:

```{r}
# Interpolate continuous variables
ec_complete <- ec_daily_mngmnt4 %>%
  arrange(management, date) %>%
  group_by(management) %>%
  mutate(
    # Linear interpolation (na.approx)
    # maxgap parameter limits how many consecutive NAs to interpolate
    VPD_gf = na.approx(VPD, 
                    na.rm = FALSE)) %>%  
                    # maxgap = 7),  # max 7 day gap
  # ) %>%
  ungroup()
```

OR caluculate VPD for gaps using the following:

```{r}

vpdcalc <- all_ec %>% 
  select(date, time, air_temperature, e, es, RH, VPD) %>%
  mutate(
    VPD_eddypro_Pa = es - e,
    VPD_eddypro_kPa = (es - e)/1000,
    # also calculate using your own:
    SVP_calc = 610.78 * exp(air_temperature/(air_temperature+237.3)*17.2694),
    AVP_calc = (RH / 100) * SVP_calc,
    VPD_calc_kPa = SVP_calc - AVP_calc,
    VPD_calc_Pa = (SVP_calc - AVP_calc)*1000
  )

ec_complete <- ec_complete %>% 
  arrange(management, date) %>% 
  group_by(management) %>% 
  mutate(    


    # calculated VPD using empirical temp and RH data
    # first calculate SVP, or the maximum saturation vapor pressure aka amount of water vapor the air at a certain temp can hold
    svp = 610.78 * exp(airt/(airt+237.3)*17.2694), # in Pascals
    # then calculate AVP, actual vapor pressure, the amount of water vapor in the air at a certain temp
    avp = (rh / 100) * svp, # Pascals
    # VPD = SVP - AVP, and represents how much more room in the air there is for water vapor at that temperature
    VPD_calc = svp - avp
  ) %>% 
  ungroup()
```


