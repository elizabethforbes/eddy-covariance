## Models

```{r}
# load fitted GAM models from average daily analyses for each flux
g_NEE <- gam(NEE ~ 
            management * # interaction
            crop_stage_simple +
            s(year, bs = "re", by = as.factor(management)) + # random effect of year
            s(doy, bs = "cc", k = 20) +  # seasonal pattern, cyclical
              
            ti(soilt_avg, vwc_avg, by = as.factor(management), k = c(8, 8)) +
            
            s(soilt_avg, by = as.factor(management), k = 10) +
            s(VPD, by = as.factor(management), k = 10) +
            s(vwc_avg, by = as.factor(management), k = 10) +
            s(days_since_tillage, by = as.factor(management), k = 8),

          data = ec_daily_mngmnt4,
          method = "REML")

g_GPP <- gam(GPP ~ 
            management * # interaction
            crop_stage_simple +
            s(year, bs = "re", by = as.factor(management)) + # random effect of year
            s(doy, bs = "cc", k = 20) +  # seasonal pattern, cyclical
              
            ti(soilt_avg, vwc_avg, by = as.factor(management), k = c(8, 8)) +
            
            s(soilt_avg, by = as.factor(management), k = 10) +
            s(VPD, by = as.factor(management), k = 10) +
            s(vwc_avg, by = as.factor(management), k = 10) +
            s(days_since_tillage, by = as.factor(management), k = 8),

          data = ec_daily_mngmnt4,
          method = "REML")

g_Reco <- gam(Reco ~ 
            management * # interaction
            crop_stage_simple +
            s(year, bs = "re", by = as.factor(management)) + # random effect of year
            s(doy, bs = "cc", k = 20) +  # seasonal pattern, cyclical
              
            ti(soilt_avg, vwc_avg, by = as.factor(management), k = c(8, 8)) +
            
            s(soilt_avg, by = as.factor(management), k = 10) +
            s(VPD, by = as.factor(management), k = 10) +
            s(vwc_avg, by = as.factor(management), k = 10) +
            s(days_since_tillage, by = as.factor(management), k = 8),

          data = ec_daily_mngmnt4,
          method = "REML")
```

## Method 1: Pull gap-filled data for gaps in empirical data

```{r}
# use coalesce function
# coalesce(empirical, gap_filled) checks empirical first; if it’s not NA, it uses that.
# If empirical is NA, it uses the corresponding gap_filled value.

ec_daily_NEEgf1 <- 
  ec_daily_mngmnt4 %>% 
  mutate(NEE_emp_gf = coalesce(NEE, NEE_gapfilled)) %>% 
  # clean up the df
  select(!c(current_plant_date, current_harvest_date, in_season, crop_type, tillage_event, last_tillage, fertilizer_event, last_fertilizer, days_since_fertilizer, herbicide_event, last_herbicide, days_since_herbicide, last_harvest, last_harvest_same_crop, days_since_last_harvest_same_crop, days_since_planting, days_to_harvest, days_since_season_end_harvest, days_since_last_harvest))

```

Now that the data is gap-filled with estimates developed with Kyle's random forest model, we can calculate yearly cumulative NEE and total cumulative NEE.
```{r}
