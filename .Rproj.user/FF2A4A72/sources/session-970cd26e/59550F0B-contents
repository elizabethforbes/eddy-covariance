# convert pressure columns from kPa to hPa to match the fluxbot data
berryhill_met <- berryhill_met %>% 
  mutate(press_station_hPa = 10*pressure_station,
         press_sea_hPa = 10*pressure_sea) %>% 
  mutate(Time = as.POSIXct(unixtime,
                           format = "%Y-%m-%d %H:%M:%S",
                           tz = "America/St_Johns"))

# Define a function to apply the process to a single data frame
join_met_data <- function(df) {
  df <- df %>%
    left_join(berryhill_met,
              join_by(closest(Time>=Time))) %>% 
    select(Time.x, co2_ppm, humidity_percent, temp_C, pressure_hPa, 
           press_station_hPa, wind_speed) %>%
    rename(Time = Time.x)
  
  return(df)
}

# Apply the function to each data frame in the list using purrr::map
fluxdat_metdata_list <- map(fluxdat_GMNP_list, join_met_data)
