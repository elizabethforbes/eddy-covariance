# generate a viable start-end df: this will have start/end brackets for the wanted observation intervals for every hour between the earliest and latest datetimes identified above (this can also be determined manually)
start_datetime <- as.POSIXct("2024-06-10 00:00:00", tz = "America/St_Johns")
end_datetime <- as.POSIXct("2024-07-06 00:00:00", tz = "America/St_Johns")
interval_length <- as.difftime(1, units = "hours")  # 1 hour interval

generate_interval_df <- function(start_datetime, end_datetime, interval_length, start_minute, start_second, end_minute, end_second) {
  # Initialize empty vectors to store start and end timestamps
  start_timestamps <- c()
  end_timestamps <- c()
  
  # Loop through each hour and generate start and end timestamps
  current_hour <- trunc(start_datetime, "hour")
  while (current_hour < end_datetime) {
    start_interval <- current_hour + as.difftime(start_minute, units = "mins") + as.difftime(start_second, units = "secs")
    end_interval <- current_hour + as.difftime(end_minute, units = "mins") + as.difftime(end_second, units = "secs")
    
    # Ensure end interval does not exceed end_datetime
    end_interval <- min(end_interval, end_datetime)
    
    # Append start and end timestamps to vectors
    start_timestamps <- c(start_timestamps, start_interval)
    end_timestamps <- c(end_timestamps, end_interval)
    
    # Move to the next hour
    current_hour <- current_hour + as.difftime(1, units = "hours")
  }
  
  # Convert the vectors to POSIXct format
  start_timestamps <- as.POSIXct(start_timestamps, origin = "1970-01-01", tz = "America/St_Johns")
  end_timestamps <- as.POSIXct(end_timestamps, origin = "1970-01-01", tz = "America/St_Johns")
  
  # Create a data frame from the start and end timestamps
  interval_df <- data.frame(Start = start_timestamps, End = end_timestamps)
  return(interval_df)
}


start_end <- generate_interval_df(start_datetime, end_datetime,
